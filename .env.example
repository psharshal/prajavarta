# ─────────────────────────────────────────────────────────────────
# PRAJAVARTA — Environment Variables
# Copy this file to .env and fill in every value before deploying.
# Never commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────────

# Database — MySQL / MariaDB
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://prajavarta:YOUR_DB_PASSWORD@localhost:3306/prajavarta"

# JWT secrets — generate with: openssl rand -base64 48
JWT_SECRET="generate-with-openssl-rand-base64-48"

# Cron secret — used in setup-cron.sh and protects /api/cron/score
CRON_SECRET="generate-with-openssl-rand-base64-24"

# App URLs — no trailing slash
NEXT_PUBLIC_APP_NAME="प्रजावार्ता"
NEXT_PUBLIC_API_URL="https://prajavarta.com"

# GeoLite2 — free MaxMind database for IP geolocation
# 1. Register free at https://dev.maxmind.com/
# 2. Download GeoLite2-City.mmdb
# 3. Place it on the server (e.g. /opt/GeoLite2-City.mmdb)
# 4. Set the path below
GEOLITE2_PATH="/opt/GeoLite2-City.mmdb"

# Claude API — for AI-powered auto-tagger (Phase 2, optional)
# ANTHROPIC_API_KEY="sk-ant-..."

# SMTP — for email notifications (optional)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@prajavarta.com"
# SMTP_PASS="your-smtp-password"
