# ─────────────────────────────────────────────────────────────────
# Development-only defaults — committed to git, safe to share.
# For production or local overrides, create a .env.local file.
# ─────────────────────────────────────────────────────────────────

# Linux socket path (use ?socket= for socket-only MySQL installs)
DATABASE_URL="mysql://prajavarta:prajavarta_dev@localhost/prajavarta?socket=/run/mysqld/mysqld.sock"

# Dev JWT secret — fine for localhost, change before deploying
JWT_SECRET="prajavarta-dev-jwt-2026-change-before-production"

CRON_SECRET="prajavarta-dev-cron-2026"

NEXT_PUBLIC_APP_NAME="प्रजावार्ता"
NEXT_PUBLIC_API_URL="http://localhost:3000"

GEOLITE2_PATH="/opt/GeoLite2-City.mmdb"
